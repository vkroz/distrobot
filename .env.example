# Creator Publisher configuration. Copy to `.env` (git-ignored) and fill in what you need.
# Everything is optional: with no values set, the app runs fully in dry-run mode.

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL of this app. Used to build OAuth redirect URIs
# ($APP_URL/api/auth/<platform>/callback) and as an allowed Origin for the CSRF check.
# Behind a reverse proxy that rewrites the Host header, set this to the public URL,
# otherwise browser POST/PUT/DELETE requests (incl. login) are rejected with 403.
APP_URL=http://localhost:8000

# SQLite database file. Default: ./data/app.db
# DATABASE_PATH=./data/app.db

# Where uploaded videos/thumbnails are stored. Default: ./data/uploads
# UPLOAD_DIR=./data/uploads

# APP_ENV=production   # enables the production login requirements below

# ─── App login (single admin) ────────────────────────────────────────────────
# Every page and API requires login, except /login, /api/session, /api/health and OAuth callbacks.
# Development: if unset, the demo login admin / admin and a built-in dev secret are used
#   (a warning banner is shown). Production (APP_ENV=production): all three are REQUIRED,
#   otherwise login is disabled. Set real values before binding to a reachable address (--host 0.0.0.0).
# Logout signs out every session; repeated failed logins are slowed down (global, max ~5 s each).
# APP_USERNAME=admin
# APP_PASSWORD=change-me
# Random string, at least 16 chars (e.g. `openssl rand -hex 32`). Changing it (or the password)
# signs everyone out.
# APP_SESSION_SECRET=

# ─── Media probing ───────────────────────────────────────────────────────────
# Uploaded videos are measured with ffprobe (duration, width, height). Lookup order:
# FFPROBE_PATH → `ffprobe` on PATH (install ffmpeg).
# If none works, the browser-reported values are used instead.
# FFPROBE_PATH=/usr/bin/ffprobe

# ─── Publishing mode ─────────────────────────────────────────────────────────
# DRY_RUN=true   → every platform is simulated (fake result links, nothing is posted)
# DRY_RUN=false  → always call real APIs (unconfigured platforms fail)
# unset          → simulate only platforms whose OAuth credentials below are missing
# DRY_RUN=

# Simulated upload duration for dry-run jobs, in ms. Default: 1500
# DRY_RUN_DELAY_MS=1500

# ─── Background worker (runs inside the web server process) ─────────────────
# How often to poll for due jobs, in ms. Default: 5000
# WORKER_INTERVAL_MS=5000
# Max jobs uploading at once. Default: 2
# WORKER_CONCURRENCY=2
# Set to true to disable the worker in this process (jobs are then never processed by it).
# WORKER_DISABLED=false
# Single instance only: the worker takes a lease in the SQLite DB; a second process using the same
# DB stays in standby and takes over only if the first stops heartbeating (~60 s).

# ─── Platform OAuth credentials ──────────────────────────────────────────────
# Leave a pair blank to keep that platform unconfigured (dry-run in auto mode).
# Register this redirect URI with each provider:  $APP_URL/api/auth/<platform>/callback
#   e.g. http://localhost:8000/api/auth/youtube/callback

# YouTube — Google Cloud Console → enable "YouTube Data API v3" → OAuth client (Web application).
# Scopes: youtube.upload, youtube.readonly. Unaudited projects can only upload private videos.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok — developers.tiktok.com → app with Login Kit + Content Posting API (Direct Post).
# Scopes: user.info.basic, video.upload, video.publish. Unaudited apps can only post as private (SELF_ONLY).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram — developers.facebook.com → app with "Instagram API with Instagram Login".
# Scopes: instagram_business_basic, instagram_business_content_publish. Needs a Business/Creator account.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Facebook Pages — developers.facebook.com → app with Facebook Login.
# Scopes: pages_show_list, pages_read_engagement, pages_manage_posts, publish_video (App Review required for others' pages).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# X — developer.x.com → project/app with OAuth 2.0 (confidential client), PKCE is used.
# Scopes: tweet.read, tweet.write, users.read, media.write, offline.access. Posting requires a paid API tier.
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn — linkedin.com/developers → app with "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn".
# Scopes: openid, profile, w_member_social.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Vimeo — developer.vimeo.com → app with upload access requested.
# Scopes: public, private, upload, edit.
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=

# ─── Optional API version pins ───────────────────────────────────────────────
# FACEBOOK_GRAPH_VERSION=v23.0
# INSTAGRAM_GRAPH_VERSION=v23.0
# LinkedIn versioned REST API (YYYYMM)
# LINKEDIN_API_VERSION=202509
