# SQLite file (defaults to ./data/app.db)
# DATABASE_PATH=./data/app.db
# Upload directory (defaults to ./data/uploads)
# UPLOAD_DIR=./data/uploads

# Public base URL used to build OAuth redirect URIs
APP_URL=http://localhost:3000

# When "true", all publish jobs run in dry-run mode regardless of per-job flag
PUBLISH_DRY_RUN=true

# OAuth client credentials per platform (leave blank to keep a platform unconfigured)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
