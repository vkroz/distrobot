# SQLite file (defaults to ./data/app.db)
# DATABASE_PATH=./data/app.db
# Upload directory (defaults to ./data/uploads)
# UPLOAD_DIR=./data/uploads

# Public base URL used to build OAuth redirect URIs
APP_URL=http://localhost:3000

# Dry-run mode: "true" = simulate every platform, "false" = always call real APIs,
# unset = simulate only platforms whose OAuth credentials below are missing.
# DRY_RUN=
# Simulated upload time for dry-run jobs (ms)
# DRY_RUN_DELAY_MS=1500

# In-process worker
# WORKER_INTERVAL_MS=5000
# WORKER_CONCURRENCY=2
# WORKER_DISABLED=false

# OAuth client credentials per platform (leave blank to keep a platform unconfigured).
# Redirect URI to register with each provider: $APP_URL/api/auth/<platform>/callback
# e.g. http://localhost:3000/api/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=

# Optional API versions
# FACEBOOK_GRAPH_VERSION=v23.0
# INSTAGRAM_GRAPH_VERSION=v23.0
# LINKEDIN_API_VERSION=202509
